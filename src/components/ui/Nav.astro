---
import { Image } from 'astro:assets';
import logo from '../../assets/LOGOSINFONDO.png';
---

<header class="sticky top-0 z-40 bg-brand-cream/95 backdrop-blur-sm shadow-[0_8px_30px_rgb(0,0,0,0.04)]">
  <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <Image src={logo} alt="Drip Bag" class="h-12 w-auto" />
    </a>

    <div class="flex items-center gap-6 md:gap-8">
      <a href="/shop" class="font-accent text-[10px] md:text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange transition-colors">
        Tienda
      </a>
      <a href="/galeria" class="font-accent text-[10px] md:text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange transition-colors hidden md:inline">
        Galería
      </a>
      <a href="/ritual" class="font-accent text-[10px] md:text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange transition-colors hidden md:inline">
        Ritual
      </a>
      <a href="/experiencia" class="font-accent text-[10px] md:text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange transition-colors hidden md:inline">
        Experience
      </a>
      <button
        aria-label="Abrir carrito"
        class="relative p-2 text-brand-blue hover:text-brand-orange transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
        <span class="absolute -top-1 -right-1 w-5 h-5 bg-brand-orange text-white text-xs font-bold rounded-full flex items-center justify-center">
          0
        </span>
      </button>
    </div>
  </nav>
</header>