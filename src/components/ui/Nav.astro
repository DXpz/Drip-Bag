---
import { Image } from 'astro:assets';
import logo from '../../assets/LOGOSINFONDO.png';
---

<header class="fixed inset-x-0 top-0 z-50 bg-brand-cream/95 backdrop-blur-sm shadow-[0_8px_30px_rgb(0,0,0,0.04)]">
  <nav class="max-w-7xl mx-auto px-4 md:px-6 py-3 md:py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <Image src={logo} alt="Café sin prisa" class="h-9 md:h-12 w-auto" />
    </a>

    <div class="hidden md:flex items-center gap-8">
      <a href="/shop" class="font-accent text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange">Tienda</a>
      <a href="/galeria" class="font-accent text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange">Galería</a>
      <a href="/ritual" class="font-accent text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange">Tu Experiencia</a>
      <a href="/experiencia" class="font-accent text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange">La Colección</a>
      <button aria-label="Carrito" class="relative p-2 text-brand-blue hover:text-brand-orange">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
        <span class="absolute -top-1 -right-1 w-5 h-5 bg-brand-orange text-white text-xs font-bold rounded-full flex items-center justify-center">0</span>
      </button>
    </div>

    <button id="menu-btn" aria-label="Menú" class="md:hidden p-2 text-brand-blue z-50">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </nav>
</header>

<div id="menu" class="fixed inset-0 z-40 hidden flex-col items-center justify-center">
  <div class="absolute inset-0 bg-brand-cream"></div>
  <div class="menu-logo relative z-10 opacity-0">
    <img src="/_astro/LOGOSINFONDO.C7JNKicG_Z28CJ8B.webp" alt="Café sin prisa" class="w-32 h-auto mx-auto" />
  </div>
  <div class="relative z-10 px-8 w-full mt-8">
    <nav class="flex flex-col gap-1">
      <a href="/shop" class="menu-link font-display text-2xl text-brand-blue py-4 border-b border-brand-blue/10 opacity-0">Tienda</a>
      <a href="/galeria" class="menu-link font-display text-2xl text-brand-blue py-4 border-b border-brand-blue/10 opacity-0">Galería</a>
      <a href="/ritual" class="menu-link font-display text-2xl text-brand-blue py-4 border-b border-brand-blue/10 opacity-0">Tu Experiencia</a>
      <a href="/experiencia" class="menu-link font-display text-2xl text-brand-blue py-4 border-b border-brand-blue/10 opacity-0">La Colección</a>
    </nav>
  </div>
  <div class="absolute bottom-8 left-0 right-0 px-8 z-10">
    <a href="/shop" class="flex items-center gap-3 text-brand-blue/60 justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
      </svg>
      <span class="font-accent text-sm uppercase tracking-[0.1em]">Ver Carrito</span>
    </a>
  </div>
  <button id="menu-close" class="absolute top-4 right-4 p-2 text-brand-blue z-20">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
    </svg>
  </button>
</div>

<script is:inline>
  (function() {
    var menuBtn = document.getElementById('menu-btn');
    var menuClose = document.getElementById('menu-close');
    var menu = document.getElementById('menu');
    var menuLinks = menu ? menu.querySelectorAll('a') : [];
    var menuLogo = menu ? menu.querySelector('.menu-logo') : null;

    if (menuBtn && menu) {
      menuBtn.onclick = function() {
        menu.classList.remove('hidden');
        menu.classList.add('flex');

        gsap.fromTo(menu, { opacity: 0, scale: 0.92 }, { opacity: 1, scale: 1, duration: 0.5, ease: 'power2.out' });
        gsap.fromTo(menuLogo, { opacity: 0, y: 40, scale: 0.7, rotation: -10 }, { opacity: 1, y: 0, scale: 1, rotation: 0, duration: 0.7, ease: 'back.out(2)' });
        gsap.fromTo(menuLinks, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: 'power3.out' });
      };

      menuClose.onclick = function() {
        gsap.to(menuLogo, { opacity: 0, scale: 0.7, y: -30, rotation: 10, duration: 0.3, ease: 'power2.in' });
        gsap.to(menu, { opacity: 0, scale: 0.92, duration: 0.35, ease: 'power2.in', onComplete: function() {
          menu.classList.remove('flex');
          menu.classList.add('hidden');
          menu.style.opacity = '';
          gsap.set(menuLinks, { opacity: 0 });
          gsap.set(menuLogo, { opacity: 0, y: 40, scale: 0.7, rotation: -10 });
        }});
      };

      menuLinks.forEach(function(link) {
        link.onclick = function() {
          gsap.to(menu, { opacity: 0, duration: 0.25, ease: 'power2.in', onComplete: function() {
            menu.classList.remove('flex');
            menu.classList.add('hidden');
            menu.style.opacity = '';
          }});
        };
      });
    }
  })();
</script>