---
import { Image } from 'astro:assets';
import logo from '../../assets/LOGOSINFONDO.png';
---

<header class="fixed inset-x-0 top-0 z-50 bg-brand-cream/95 backdrop-blur-sm shadow-[0_8px_30px_rgb(0,0,0,0.04)]">
  <nav class="max-w-7xl mx-auto px-4 md:px-6 py-3 md:py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <Image src={logo} alt="Café sin prisa" class="h-9 md:h-12 w-auto" />
    </a>

    <div class="hidden md:flex items-center gap-8">
      <a href="/shop" class="font-accent text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange">Tienda</a>
      <a href="/galeria" class="font-accent text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange">Galería</a>
      <a href="/ritual" class="font-accent text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange">Tu Experiencia</a>
      <a href="/experiencia" class="font-accent text-xs uppercase tracking-[0.15em] text-brand-blue/70 hover:text-brand-orange">La Colección</a>
      <button aria-label="Carrito" class="relative p-2 text-brand-blue hover:text-brand-orange">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
        <span class="absolute -top-1 -right-1 w-5 h-5 bg-brand-orange text-white text-xs font-bold rounded-full flex items-center justify-center">0</span>
      </button>
    </div>

    <button id="menu-btn" aria-label="Menú" class="md:hidden p-2 text-brand-blue z-50">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </nav>
</header>

<div id="menu" class="fixed inset-0 z-40 hidden flex-col">
  <div class="menu-steam steam-1"></div>
  <div class="menu-steam steam-2"></div>
  <div class="menu-steam steam-3"></div>
  <div class="absolute inset-0 bg-brand-cream menu-panel"></div>
  <div class="relative h-full w-full flex flex-col">
    <div class="flex justify-end p-4">
      <button id="menu-close" class="p-2 text-brand-blue">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="flex-1 flex flex-col justify-center px-8 gap-2">
      <a href="/shop" class="menu-link font-display text-3xl text-brand-blue py-3 border-b border-brand-blue/10 opacity-0 translate-y-4">Tienda</a>
      <a href="/galeria" class="menu-link font-display text-3xl text-brand-blue py-3 border-b border-brand-blue/10 opacity-0 translate-y-4">Galería</a>
      <a href="/ritual" class="menu-link font-display text-3xl text-brand-blue py-3 border-b border-brand-blue/10 opacity-0 translate-y-4">Tu Experiencia</a>
      <a href="/experiencia" class="menu-link font-display text-3xl text-brand-blue py-3 border-b border-brand-blue/10 opacity-0 translate-y-4">La Colección</a>
    </nav>
    <div class="p-8 border-t border-brand-blue/10">
      <a href="/shop" class="flex items-center gap-3 text-brand-blue">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
        <span class="font-accent text-sm uppercase tracking-[0.1em]">Ver Carrito</span>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var menuBtn = document.getElementById('menu-btn');
    var menuClose = document.getElementById('menu-close');
    var menu = document.getElementById('menu');
    var menuLinks = menu ? menu.querySelectorAll('a') : [];
    var steamElements = menu ? menu.querySelectorAll('.menu-steam') : [];
    var menuLinkElements = menu ? menu.querySelectorAll('.menu-link') : [];

    if (menuBtn && menu) {
      menuBtn.onclick = function() {
        menu.classList.remove('hidden', 'closing');
        menu.classList.add('flex');
        menu.style.animation = 'steam-rise 0.5s ease-out forwards';

        steamElements.forEach(function(el, i) {
          el.style.animation = 'steam-float 2s ease-out ' + (i * 0.2) + 's infinite';
        });

        menuLinkElements.forEach(function(el, i) {
          setTimeout(function() {
            el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
          }, 150 + (i * 80));
        });
      };

      menuClose.onclick = function() {
        menu.classList.add('closing');
        steamElements.forEach(function(el) {
          el.style.animation = 'none';
        });
        setTimeout(function() {
          menu.classList.remove('flex', 'closing');
          menu.classList.add('hidden');
          menu.style.animation = '';
          menuLinkElements.forEach(function(el) {
            el.style.opacity = '0';
            el.style.transform = 'translateY(16px)';
          });
        }, 400);
      };

      menuLinks.forEach(function(link) {
        link.onclick = function() {
          menu.classList.add('closing');
          setTimeout(function() {
            menu.classList.remove('flex', 'closing');
            menu.classList.add('hidden');
            menu.style.animation = '';
          }, 400);
        };
      });
    }
  })();
</script>