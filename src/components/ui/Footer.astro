---
import { Image } from 'astro:assets';
import logo from '../../assets/LOGOSINFONDO.png';
---

<footer class="border-t border-brand-blue/15 mt-24">
  <div class="max-w-7xl mx-auto px-6 py-16 text-center">
    <Image src={logo} alt="Drip Bag" class="h-16 w-auto mx-auto mb-6 opacity-70" />
    <p class="font-accent text-xs uppercase tracking-[0.2em] text-brand-blue/60 mb-4">Cafecito Práctico</p>
    <p class="text-sm text-brand-blue/40">© 2026 Café sin prisa. El Salvador.</p>
  </div>
</footer>