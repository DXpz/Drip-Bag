---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
---

<Layout title="Tu Ritual | Drip Bag" description="El ritual del café drip bag explicado paso a paso">
  <Nav />

  <main class="min-h-screen">
    <section class="px-6 py-16 md:py-24 text-center">
      <a href="/shop" class="font-accent text-xs uppercase tracking-[0.15em] text-brand-blue/40 hover:text-brand-orange transition-colors mb-4 inline-block">← Tienda</a>
      <p class="font-accent text-xs uppercase tracking-[0.3em] text-brand-orange mb-4">Tu Ritual Privado</p>
      <h1 class="font-display text-4xl md:text-6xl text-brand-blue mb-6">La maestría de un barista, en tus manos.</h1>
      <p class="font-body text-brand-blue/60 max-w-2xl mx-auto">
        Tres pasos. Tres momentos. Un ritual que transforma cualquier momento ordinario en algo extraordinario.
      </p>
    </section>

    <section class="ritual-scrollytelling max-w-4xl mx-auto relative" id="ritual-scrolly">
      <div class="ritual-frame sticky top-1/2 -translate-y-1/2 flex items-center justify-center h-[400px] z-10">
        <svg class="ritual-svg w-64 h-64" viewBox="0 0 200 200" fill="none">
          <g id="step1" class="ritual-step-group">
            <rect class="ritual-pack" x="70" y="50" width="60" height="80" rx="4" stroke="#4B65D1" stroke-width="1" fill="none"/>
            <text x="100" y="95" text-anchor="middle" font-family="serif" font-size="14" fill="#4B65D1">DB</text>
          </g>
          <g id="step2" class="ritual-step-group" style="opacity: 0; transition: opacity 0.5s ease;">
            <path d="M85 130 Q100 140 115 130" stroke="#4B65D1" stroke-width="0.5" fill="none"/>
            <line x1="100" y1="130" x2="100" y2="155" stroke="#4B65D1" stroke-width="0.5"/>
            <ellipse cx="100" cy="165" rx="30" ry="8" stroke="#4B65D1" stroke-width="0.5" fill="none"/>
            <line x1="70" y1="120" x2="130" y2="120" stroke="#4B65D1" stroke-width="0.5"/>
          </g>
          <g id="step3" class="ritual-step-group" style="opacity: 0; transition: opacity 0.5s ease;">
            <path d="M100 60 Q100 100 100 155" stroke="#4B65D1" stroke-width="0.3"/>
            <ellipse cx="100" cy="165" rx="25" ry="6" stroke="#4B65D1" stroke-width="0.5" fill="none"/>
            <ellipse cx="100" cy="162" rx="15" ry="4" stroke="#4B65D1" stroke-width="0.3" fill="#4B65D1" fill-opacity="0.1"/>
          </g>
        </svg>
      </div>

      <div class="ritual-texts relative z-10 bg-brand-cream/80 backdrop-blur-sm">
        <div class="ritual-text-item h-[350px] flex items-center justify-center" data-step="1">
          <div class="text-center transition-opacity duration-500">
            <span class="font-accent text-[10px] uppercase tracking-[0.3em] text-brand-orange block mb-4">Primer momento</span>
            <h3 class="font-display text-4xl text-brand-blue mb-4">Rasga el filtro</h3>
            <p class="font-body text-brand-blue/60 max-w-md mx-auto">Descubre el aroma que despierta tus sentidos. La textura del papel cruje bajo tus dedos anticipando lo que viene.</p>
          </div>
        </div>
        <div class="ritual-text-item h-[350px] flex items-center justify-center" data-step="2">
          <div class="text-center opacity-30 transition-opacity duration-500">
            <span class="font-accent text-[10px] uppercase tracking-[0.3em] text-brand-orange block mb-4">Segundo momento</span>
            <h3 class="font-display text-4xl text-brand-blue mb-4">Ancla el drip</h3>
            <p class="font-body text-brand-blue/60 max-w-md mx-auto">Deja que repose elegantemente sobre tu taza. Los bordes se ajustan con precisión milimétrica.</p>
          </div>
        </div>
        <div class="ritual-text-item h-[350px] flex items-center justify-center" data-step="3">
          <div class="text-center opacity-30 transition-opacity duration-500">
            <span class="font-accent text-[10px] uppercase tracking-[0.3em] text-brand-orange block mb-4">Tercer momento</span>
            <h3 class="font-display text-4xl text-brand-blue mb-4">Vierte el agua</h3>
            <p class="font-body text-brand-blue/60 max-w-md mx-auto">Observa cómo el tiempo se detiene en cada gota. El café se libera lentamente, liberando todo su potencial.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="px-6 py-16 md:py-24 text-center">
      <p class="font-body text-brand-blue/60 mb-6">Listo para vivirlo?</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/shop" class="btn-secondary">Ver la Colección</a>
        <a href="/experiencia" class="btn-primary">The Experience</a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const scrollyContainer = document.getElementById('ritual-scrolly');
    if (scrollyContainer) {
      const textItems = scrollyContainer.querySelectorAll('.ritual-text-item');
      const stepGroups = scrollyContainer.querySelectorAll('.ritual-step-group');

      window.addEventListener('scroll', () => {
        const rect = scrollyContainer.getBoundingClientRect();
        const containerHeight = scrollyContainer.offsetHeight;
        const viewportHeight = window.innerHeight;
        const scrollProgress = Math.max(0, Math.min(1, -rect.top / (containerHeight - viewportHeight)));

        const stepIndex = Math.floor(scrollProgress * 3);
        const clampedStep = Math.min(stepIndex, 2);

        stepGroups.forEach((group, i) => {
          group.style.opacity = i === clampedStep ? '1' : '0';
        });

        textItems.forEach((item, i) => {
          const div = item.querySelector('div');
          if (div) {
            div.style.opacity = i === clampedStep ? '1' : '0.3';
          }
        });
      });
    }
  </script>

  <style>
    .ritual-texts {
      mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
    }
  </style>
</Layout>