---
import { Image } from 'astro:assets';
import logo from '../assets/LOGOSINFONDO.png';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
---

<Layout title="Café sin prisa | Premium Coffee from El Salvador">
  <Nav />

  <main>
    <section class="min-h-[80vh] flex items-center justify-center px-6 py-24 pt-24">
      <div class="text-center max-w-3xl mx-auto">
        <div class="mb-8 flex justify-center">
          <Image src={logo} alt="Café sin prisa" class="h-28 md:h-40 w-auto opacity-90" />
        </div>
        <p class="font-accent text-xs uppercase tracking-[0.3em] text-brand-orange mb-6">El Salvador</p>
        <h1 class="font-display text-4xl md:text-6xl text-brand-blue mb-6 leading-tight">
          Cafecito sin prisa<br />para gente con prisa
        </h1>
        <p class="text-base md:text-lg text-brand-blue/60 mb-10 max-w-xl mx-auto leading-relaxed">
          Drip bags premium que transforman cualquier momento en algo elegante.
          Práctico, sofisticado, delicioso.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/shop" class="btn-primary w-full sm:w-auto">Explorar la Tienda</a>
          <a href="/galeria" class="btn-secondary w-full sm:w-auto">Ver Galería</a>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12 md:mb-16">
          <p class="font-accent text-[10px] uppercase tracking-[0.3em] text-brand-orange mb-3">Origen</p>
          <h2 class="font-display text-2xl md:text-4xl text-brand-blue">El Terroir Salvadoreño</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
          <div class="bg-gradient-to-br from-brand-blue/5 to-brand-blue/10 rounded-sm p-6 md:p-8">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-brand-blue/10 flex items-center justify-center">
                <span class="font-display text-lg text-brand-blue">900-1200m</span>
              </div>
              <h3 class="font-display text-lg text-brand-blue">Café de Origen</h3>
            </div>
            <p class="text-sm text-brand-blue/70 leading-relaxed mb-4">
              Cultivados entre 900 y 1,200 metros sobre el nivel del mar. Estas altitudes ofrecen un clima fresco y lluvias equilibradas que permiten desarrollar sabores complejos con notas frutales y acidez vibrante.
            </p>
            <p class="font-accent text-[10px] uppercase tracking-[0.15em] text-brand-blue/50">Tradicional • Vainilla • Almendra • Amaretto</p>
          </div>

          <div class="relative bg-gradient-to-br from-brand-orange/5 to-brand-orange/10 rounded-sm p-6 md:p-8 overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-brand-orange/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="relative">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-full bg-brand-orange/20 flex items-center justify-center">
                  <span class="font-display text-lg text-brand-orange">1500m</span>
                </div>
                <div>
                  <h3 class="font-display text-lg text-brand-blue">Finca Santa Lucía</h3>
                  <p class="font-accent text-[10px] uppercase tracking-[0.15em] text-brand-orange">Edición Premium</p>
                </div>
              </div>
              <p class="text-sm text-brand-blue/70 leading-relaxed mb-4">
                Proveniente de Finca Santa Lucía, nuestra finca principal en El Salvador a 1,500 metros. La mayor altitud significa menos oxígeno, más estrés para la planta y una concentración excepcional de azúcares naturales. El resultado: una taza más dulce, más densa y con una complejidad aromática que solo se logra en las alturas.
              </p>
              <p class="font-accent text-[10px] uppercase tracking-[0.15em] text-brand-orange/70">Café de especialidad • Cosecha selecta</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 text-center">
          <a href="/shop" class="p-6 md:p-8 group">
            <div class="w-14 h-14 md:w-16 md:h-16 mx-auto mb-5 md:mb-6 rounded-full bg-brand-blue/5 flex items-center justify-center group-hover:bg-brand-blue/10 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#4B65D1" class="w-7 h-7">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
              </svg>
            </div>
            <h3 class="font-display text-lg md:text-xl text-brand-blue mb-2 md:mb-3 group-hover:text-brand-orange transition-colors">Tienda</h3>
            <p class="text-brand-blue/60 text-sm leading-relaxed">Descubre nuestros sabores premium.</p>
          </a>
          <a href="/galeria" class="p-6 md:p-8 group">
            <div class="w-14 h-14 md:w-16 md:h-16 mx-auto mb-5 md:mb-6 rounded-full bg-brand-orange/5 flex items-center justify-center group-hover:bg-brand-orange/10 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#E6735C" class="w-7 h-7">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />
              </svg>
            </div>
            <h3 class="font-display text-lg md:text-xl text-brand-blue mb-2 md:mb-3 group-hover:text-brand-orange transition-colors">Galería</h3>
            <p class="text-brand-blue/60 text-sm leading-relaxed">Cada sabor como una obra de arte.</p>
          </a>
          <a href="/experiencia" class="p-6 md:p-8 group">
            <div class="w-14 h-14 md:w-16 md:h-16 mx-auto mb-5 md:mb-6 rounded-full bg-brand-blue/5 flex items-center justify-center group-hover:bg-brand-blue/10 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#4B65D1" class="w-7 h-7">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12.75 9 12.75s9-5.53 9-12.75Z" />
              </svg>
            </div>
            <h3 class="font-display text-lg md:text-xl text-brand-blue mb-2 md:mb-3 group-hover:text-brand-orange transition-colors">La Colección</h3>
            <p class="text-brand-blue/60 text-sm leading-relaxed">El pack completo para todo el día.</p>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>