---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
---

<Layout title="La Colección | Café sin prisa" description="El pack completo de 4 drip bags para todo el día">
  <Nav />

  <main class="pt-20">
    <section class="px-4 md:px-6 py-12 md:py-20 lg:py-24">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8 md:mb-12">
          <a href="/shop" class="font-accent text-xs uppercase tracking-[0.15em] text-brand-blue/40 hover:text-brand-orange transition-colors mb-3 md:mb-4 inline-block">← Tienda</a>
          <span class="font-accent text-[10px] uppercase tracking-[0.3em] text-brand-orange block mb-3 md:mb-4">Edición Limitada</span>
          <h1 class="font-display text-3xl md:text-5xl lg:text-6xl text-brand-blue mb-4">La Colección Completa</h1>
          <p class="font-display text-lg md:text-xl text-brand-blue/70">El Día Completo</p>
        </div>

        <div class="relative overflow-hidden rounded-md bg-gradient-to-br from-brand-blue/5 to-brand-orange/5 p-6 md:p-10 lg:p-14 mb-10 md:mb-16">
          <div class="relative z-10">
            <p class="font-body text-base md:text-lg text-brand-blue/80 max-w-2xl mx-auto text-center mb-10 md:mb-14 leading-relaxed px-2">
              Cuatro momentos, cuatro perfiles. Una selección curada para acompañar tu ritmo: la concentración del Tradicional por la mañana, la suavidad de la Vainilla al mediodía, la calma de la Almendra en la tarde y la indulgencia del Amaretto tras la cena.
            </p>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-10 md:mb-12">
              <div class="text-center p-4 md:p-6 rounded-sm bg-white/50">
                <div class="w-14 h-14 md:w-18 md:h-18 mx-auto mb-3 md:mb-4 rounded-full bg-[#8D8782]/20 flex items-center justify-center">
                  <span class="font-accent text-base md:text-lg text-[#8D8782]">TR</span>
                </div>
                <h3 class="font-display text-base md:text-lg text-[#8D8782] mb-1">Tradicional</h3>
                <p class="font-body text-xs text-[#1A1A1A]/60">Mañana</p>
                <p class="font-accent text-[10px] uppercase tracking-[0.1em] text-[#8D8782]/60 mt-2">Concentración</p>
              </div>

              <div class="text-center p-4 md:p-6 rounded-sm bg-white/50">
                <div class="w-14 h-14 md:w-18 md:h-18 mx-auto mb-3 md:mb-4 rounded-full bg-[#EFECE5]/80 flex items-center justify-center">
                  <span class="font-accent text-base md:text-lg text-[#8D8782]">VA</span>
                </div>
                <h3 class="font-display text-base md:text-lg text-[#8D8782] mb-1">Vainilla</h3>
                <p class="font-body text-xs text-[#1A1A1A]/60">Mediodía</p>
                <p class="font-accent text-[10px] uppercase tracking-[0.1em] text-[#8D8782]/60 mt-2">Suavidad</p>
              </div>

              <div class="text-center p-4 md:p-6 rounded-sm bg-white/50">
                <div class="w-14 h-14 md:w-18 md:h-18 mx-auto mb-3 md:mb-4 rounded-full bg-[#C5B7A7]/20 flex items-center justify-center">
                  <span class="font-accent text-base md:text-lg text-[#C5B7A7]">AL</span>
                </div>
                <h3 class="font-display text-base md:text-lg text-[#C5B7A7] mb-1">Almendra</h3>
                <p class="font-body text-xs text-[#1A1A1A]/60">Tarde</p>
                <p class="font-accent text-[10px] uppercase tracking-[0.1em] text-[#C5B7A7]/60 mt-2">Calma</p>
              </div>

              <div class="text-center p-4 md:p-6 rounded-sm bg-white/50">
                <div class="w-14 h-14 md:w-18 md:h-18 mx-auto mb-3 md:mb-4 rounded-full bg-[#6A4A4F]/20 flex items-center justify-center">
                  <span class="font-accent text-base md:text-lg text-[#6A4A4F]">AM</span>
                </div>
                <h3 class="font-display text-base md:text-lg text-[#6A4A4F] mb-1">Amaretto</h3>
                <p class="font-body text-xs text-[#1A1A1A]/60">Noche</p>
                <p class="font-accent text-[10px] uppercase tracking-[0.1em] text-[#6A4A4F]/60 mt-2">Indulgencia</p>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-6 md:gap-8">
              <div class="text-center">
                <span class="font-display text-4xl md:text-5xl text-brand-blue">$45</span>
                <span class="font-accent text-[10px] uppercase tracking-[0.1em] text-brand-blue/40 block mt-2">USD</span>
                <p class="font-body text-xs text-brand-blue/50 mt-2">Ahorra $11 vs comprar por separado</p>
              </div>
              <button class="btn-primary px-8 md:px-12 py-3 md:py-4 text-sm md:text-base w-full sm:w-auto">
                Adquirir la Colección
              </button>
            </div>
          </div>

          <div class="absolute top-0 right-0 w-48 h-48 md:w-64 md:h-64 bg-gradient-to-br from-brand-orange/10 to-transparent rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <div class="text-center">
          <h2 class="font-display text-xl md:text-2xl text-brand-blue mb-6 md:mb-8">¿Por qué La Colección?</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
            <div class="text-center">
              <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-blue/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#4B65D1" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
              </div>
              <h3 class="font-display text-base md:text-lg text-brand-blue mb-2">Curado por expertos</h3>
              <p class="font-body text-sm text-brand-blue/60">Cada sabor seleccionado para maximizar tu experiencia diaria.</p>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-blue/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#4B65D1" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12.75 9 12.75s9-5.53 9-12.75Z" />
                </svg>
              </div>
              <h3 class="font-display text-base md:text-lg text-brand-blue mb-2">Ritual completo</h3>
              <p class="font-body text-sm text-brand-blue/60">Desde el primer sorbo de la mañana hasta el último de la noche.</p>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-blue/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#4B65D1" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" />
                </svg>
              </div>
              <h3 class="font-display text-base md:text-lg text-brand-blue mb-2">Envío premium</h3>
              <p class="font-body text-sm text-brand-blue/60">Empaque de lujo que refleja la calidad del producto.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>