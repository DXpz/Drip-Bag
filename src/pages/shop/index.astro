---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
import CartDrawer from '../../components/react/CartDrawer';
import { getProducts } from '../../utils/shopify';

const rawProducts = await getProducts();

const products = rawProducts.map((p, i) => ({
  id: p.id,
  title: p.title,
  handle: p.handle,
  copy: p.description || 'Un café premium cultivado con amor.',
  color: ['#8D8782', '#6A4A4F', '#C5B7A7', '#EFECE5'][i % 4],
  price: p.priceRange.minVariantPrice.amount,
  image: p.images.edges[0]?.node.url,
  variantId: p.variants.edges[0]?.node.id,
  available: p.variants.edges[0]?.node.availableForSale,
}));
---

<Layout title="Tienda | Café sin prisa" description="Explora nuestra colección de drip bags premium de El Salvador">
  <Nav />

  <main class="pt-20">
    <section class="px-4 md:px-6 py-10 md:py-16">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12 md:mb-20">
          <p class="font-accent text-[10px] md:text-xs uppercase tracking-[0.3em] text-brand-orange mb-3 md:mb-4">Explora</p>
          <h1 class="font-display text-3xl md:text-5xl lg:text-6xl text-brand-blue mb-4 md:mb-6">Nuestras Notas: La Colección</h1>
          <p class="font-body text-brand-blue/60 max-w-xl mx-auto text-sm md:text-base px-4">
            Cada sabor cuenta una historia. Descubre el perfil que habla contigo.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 lg:gap-24">
          {products.map((product, index) => (
            <article
              class="sabor-card relative p-6 md:p-10 rounded-sm overflow-hidden"
              style={`background-color: ${product.color}15;`}
            >
              <div class="sabor-colour-fill absolute inset-0 pointer-events-none transition-opacity duration-500" style={`background-color: ${product.color};`}></div>

              <div class="relative z-10">
                <div class="flex items-start justify-between mb-6 md:mb-8">
                  <div>
                    <span class="font-accent text-[10px] uppercase tracking-[0.3em] text-gray-400 mb-1 md:mb-2 block">0{index + 1}</span>
                    <h2 class="font-display text-2xl md:text-3xl lg:text-4xl mb-2 md:mb-3" style={`color: ${product.color === '#EFECE5' ? '#1A1A1A' : product.color};`}>
                      {product.title}
                    </h2>
                    <p class="font-accent text-[10px] md:text-xs uppercase tracking-[0.15em]" style={`color: ${product.color === '#EFECE5' ? '#666' : product.color}; opacity: 0.8;`}>
                      Perfil Sensorial
                    </p>
                  </div>
                  <div class="text-right">
                    <span class="font-display text-xl md:text-2xl" style={`color: ${product.color === '#EFECE5' ? '#1A1A1A' : product.color};`}>
                      ${parseFloat(product.price).toFixed(2)}
                    </span>
                    <span class="font-accent text-[10px] uppercase tracking-[0.1em] text-gray-400 block mt-1">USD</span>
                  </div>
                </div>

                <div class="sabor-pack mb-6 md:mb-8 relative">
                  <div class="aspect-[4/3] rounded-md bg-gradient-to-br from-gray-200 to-gray-100 flex items-center justify-center overflow-hidden">
                    {product.image ? (
                      <img src={product.image} alt={product.title} class="w-full h-full object-cover opacity-80" loading="lazy" />
                    ) : (
                      <svg class="w-20 md:w-24 h-20 md:h-24 opacity-30" viewBox="0 0 100 100" fill="none">
                        <rect x="25" y="20" width="50" height="60" rx="4" stroke={product.color} stroke-width="1"/>
                        <text x="50" y="55" text-anchor="middle" font-family="serif" font-size="16" fill={product.color}>C</text>
                      </svg>
                    )}
                  </div>
                </div>

                <p class="font-body text-sm md:text-base leading-relaxed mb-6 md:mb-8 text-[#1A1A1A]/80">
                  {product.copy}
                </p>

                <div class="flex items-center justify-between gap-4">
                  <a href="/galeria" class="font-accent text-[10px] md:text-xs uppercase tracking-[0.15em] text-brand-blue/50 hover:text-brand-orange transition-colors whitespace-nowrap">
                    Ver en galería →
                  </a>
                  <button
                    class="add-to-cart-btn btn-secondary text-xs whitespace-nowrap"
                    data-variant-id={product.variantId}
                    data-title={product.title}
                    data-price={product.price}
                    data-image={product.image || ''}
                    disabled={!product.available || !product.variantId}
                    style={`border-color: ${product.color}40; color: ${product.color === '#EFECE5' ? '#4B65D1' : product.color}; ${!product.available ? 'opacity: 0.5; cursor: not-allowed;' : ''}`}
                  >
                    {product.available ? 'Añadir' : 'Agotado'}
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 md:px-6 py-10 md:py-16 bg-brand-blue/5">
      <div class="max-w-5xl mx-auto">
        <div class="relative overflow-hidden rounded-md bg-gradient-to-br from-brand-blue/5 to-brand-orange/5 p-6 md:p-12 lg:p-16">
          <div class="relative z-10 text-center">
            <span class="font-accent text-[10px] uppercase tracking-[0.3em] text-brand-orange block mb-3 md:mb-4">Edición Limitada</span>
            <h2 class="font-display text-2xl md:text-4xl lg:text-5xl text-brand-blue mb-4 md:mb-6">The Drip Bag Experience</h2>
            <p class="font-display text-lg md:text-xl text-brand-blue/70 mb-4 md:mb-6">El Día Completo</p>
            <p class="font-body text-sm md:text-base text-brand-blue/60 max-w-2xl mx-auto mb-8 md:mb-10 leading-relaxed px-4">
              Cuatro momentos, cuatro perfiles. Una selección curada para acompañar tu ritmo: la concentración del Tradicional por la mañana, la suavidad de la Vainilla al mediodía, la calma de la Almendra en la tarde y la indulgencia del Amaretto tras la cena.
            </p>

            <div class="flex justify-center mb-6 md:mb-10">
              <div class="flex -space-x-3 md:-space-x-4">
                <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[#8D8782]/20 border-2 border-white flex items-center justify-center">
                  <span class="font-accent text-[10px] md:text-xs text-[#8D8782]">TR</span>
                </div>
                <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[#6A4A4F]/20 border-2 border-white flex items-center justify-center">
                  <span class="font-accent text-[10px] md:text-xs text-[#6A4A4F]">AM</span>
                </div>
                <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[#C5B7A7]/20 border-2 border-white flex items-center justify-center">
                  <span class="font-accent text-[10px] md:text-xs text-[#C5B7A7]">AL</span>
                </div>
                <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[#EFECE5]/50 border-2 border-white flex items-center justify-center">
                  <span class="font-accent text-[10px] md:text-xs text-[#8D8782]">VA</span>
                </div>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 md:gap-6">
              <div class="text-center">
                <span class="font-display text-3xl md:text-4xl text-brand-blue">$45</span>
                <span class="font-accent text-[10px] uppercase tracking-[0.1em] text-brand-blue/40 block mt-1">USD</span>
              </div>
              <a href="/experiencia" class="btn-primary w-full sm:w-auto">
                Descubrir la Colección
              </a>
            </div>
          </div>

          <div class="absolute top-0 right-0 w-48 h-48 md:w-64 md:h-64 bg-gradient-to-br from-brand-orange/10 to-transparent rounded-full blur-3xl"></div>
        </div>
      </div>
    </section>

    <section class="px-6 py-10 md:py-16 text-center">
      <p class="font-body text-brand-blue/60 mb-4 md:mb-6 text-sm md:text-base">¿Quieres la experiencia completa?</p>
      <a href="/experiencia" class="btn-secondary w-full sm:w-auto">
        Ver La Colección
      </a>
    </section>
  </main>

  <CartDrawer client:load />
  <Footer />

  <script>
    import { addToCartItem, openCart } from '../../store/cartStore';

    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const variantId = target.dataset.variantId;
        const title = target.dataset.title;
        const price = target.dataset.price;
        const image = target.dataset.image;

        if (!variantId || target.disabled) return;

        target.textContent = 'Añadiendo...';
        target.disabled = true;

        await addToCartItem({
          id: variantId,
          variantId: variantId,
          title: title || '',
          price: parseFloat(price || '0'),
          image: image || undefined,
        });

        target.textContent = 'Añadido ✓';
        openCart();

        setTimeout(() => {
          target.textContent = 'Añadir';
          target.disabled = false;
        }, 2000);
      });
    });
  </script>
</Layout>